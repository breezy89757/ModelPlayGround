# ── 必填：任何 OpenAI 相容端點都可以 ──────────────────────────
# Azure OpenAI   https://<resource>.openai.azure.com/openai/v1
# OpenAI         https://api.openai.com/v1
# Groq           https://api.groq.com/openai/v1
# OpenRouter     https://openrouter.ai/api/v1
# Ollama         http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=

# 受測模型（Azure 填 deployment 名稱）
MODEL=gpt-4o-mini


# ── 以下全部可以不填，不填就一律用 MODEL ──────────────────────

# 出題與需求解析（使用者在等，建議用快的）
# BRAIN_MODEL=
# BRAIN_EFFORT=

# 寫 system prompt、產生修補建議、檢核（建議用準的）
# AUTHOR_MODEL=
# AUTHOR_EFFORT=

# 寫 SKILL.md（結構化改寫，小模型就夠）
# SKILL_MODEL=
# SKILL_EFFORT=

# 檢核時每題重判幾次取多數決。1 = 關閉共識機制
JUDGE_VOTES=3
# JUDGE_MODEL=

# 受測模型的 reasoning effort（不支援的端點會自動忽略）
# TARGET_EFFORT=
